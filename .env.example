# TrustLayer — Environment Variables
# Copy this file to .env.local and fill in the values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- PayPal Sandbox ---
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-webhook-id
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- LLM Provider ---
# OpenAI-compatible API (works with OpenAI, Gemini, etc.)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# --- App Config ---
# Confidence threshold for auto-release (0-1). Tuned via evals.
RELEASE_CONFIDENCE=0.85
# Use mock PayPal adapter instead of real sandbox
USE_MOCK_PAYPAL=false

